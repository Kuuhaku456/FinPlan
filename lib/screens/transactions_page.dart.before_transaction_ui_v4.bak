import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../core/money.dart';

import '../models/finance_transaction.dart';

import '../state/transaction_controller.dart';
import '../state/transaction_notifier.dart';

import '../features/transactions/presentation/widgets/transaction_summary_card.dart';

import 'add_transaction_page.dart';

// =====================================================
// FINPLAN - TRANSACTIONS PAGE
// =====================================================

class TransactionsPage extends ConsumerStatefulWidget {
  const TransactionsPage({super.key, required this.controller});

  final TransactionController controller;

  @override
  ConsumerState<TransactionsPage> createState() {
    return _TransactionsPageState();
  }
}

// =====================================================
// TRANSACTION ACTION
// =====================================================

enum _TransactionAction { edit, delete }

// =====================================================
// HISTORY ENTRY
// =====================================================

class _HistoryEntry {
  const _HistoryEntry.date(this.date) : transaction = null;

  const _HistoryEntry.transaction(this.transaction) : date = null;

  final DateTime? date;
  final FinanceTransaction? transaction;
}

// =====================================================
// TRANSACTIONS PAGE STATE
// =====================================================

class _TransactionsPageState extends ConsumerState<TransactionsPage> {
  // =====================================================
  // COLORS
  // =====================================================

  static const Color _green = Color(0xFF059669);

  static const Color _darkGreen = Color(0xFF064E3B);

  static const Color _red = Color(0xFFEF4444);

  // =====================================================
  // MONTHS & DAYS
  // =====================================================

  static const List<String> _months = [
    'Januari',
    'Februari',
    'Maret',
    'April',
    'Mei',
    'Juni',
    'Juli',
    'Agustus',
    'September',
    'Oktober',
    'November',
    'Desember',
  ];

  static const List<String> _days = [
    'Senin',
    'Selasa',
    'Rabu',
    'Kamis',
    'Jumat',
    'Sabtu',
    'Minggu',
  ];

  // =====================================================
  // CONTROLLERS
  // =====================================================

  final ScrollController _scrollController = ScrollController();

  // =====================================================
  // INITIAL STATE
  // =====================================================

  @override
  void initState() {
    super.initState();

    _scrollController.addListener(_handleScroll);

    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) return;

      ref.read(transactionStateProvider.notifier).loadTransactions();
    });
  }

  // =====================================================
  // DISPOSE
  // =====================================================

  @override
  void dispose() {
    _scrollController.removeListener(_handleScroll);

    _scrollController.dispose();

    super.dispose();
  }

  // =====================================================
  // PAGINATION SCROLL
  // =====================================================

  void _handleScroll() {
    if (!_scrollController.hasClients) {
      return;
    }

    final position = _scrollController.position;

    if (position.extentAfter >= 300) {
      return;
    }

    final state = ref.read(transactionStateProvider);

    if (state.hasMore &&
        !state.isLoading &&
        !state.isLoadingMore &&
        !state.isSaving) {
      ref.read(transactionStateProvider.notifier).loadMore();
    }
  }

  // =====================================================
  // DATE FORMAT
  // =====================================================

  String _formatMonth(DateTime date) {
    return '${_months[date.month - 1]} ${date.year}';
  }

  String _formatDate(DateTime date) {
    return '${_days[date.weekday - 1]}, '
        '${date.day} '
        '${_months[date.month - 1]} '
        '${date.year}';
  }

  // =====================================================
  // MONTH NAVIGATION
  // =====================================================

  void _changeMonth(int offset) {
    final currentMonth = ref.read(transactionStateProvider).selectedMonth;

    final newMonth = DateTime(
      currentMonth.year,
      currentMonth.month + offset,
      1,
    );

    if (_scrollController.hasClients) {
      _scrollController.jumpTo(0);
    }

    ref.read(transactionStateProvider.notifier).selectMonth(newMonth);
  }

  // =====================================================
  // OPEN ADD / EDIT TRANSACTION
  // =====================================================

  Future<void> _openTransactionForm({FinanceTransaction? transaction}) async {
    await Navigator.of(context).push<bool>(
      MaterialPageRoute<bool>(
        builder: (_) {
          return AddTransactionPage(
            controller: widget.controller,
            transaction: transaction,
          );
        },
      ),
    );
  }

  // =====================================================
  // SHOW SNACKBAR
  // =====================================================

  void _showMessage(String message) {
    if (!mounted) return;

    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(content: Text(message), behavior: SnackBarBehavior.floating),
      );
  }

  // =====================================================
  // DELETE TRANSACTION
  // =====================================================

  Future<void> _confirmDelete(FinanceTransaction transaction) async {
    final transactionId = transaction.id;

    if (transactionId == null) {
      _showMessage('ID transaksi tidak ditemukan.');
      return;
    }

    final confirmed = await showDialog<bool>(
      context: context,

      builder: (dialogContext) {
        return AlertDialog(
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(22),
          ),

          title: const Text('Hapus Transaksi?'),

          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,

            children: [
              Text(
                transaction.description,
                style: const TextStyle(fontWeight: FontWeight.w700),
              ),

              const SizedBox(height: 8),

              Text(
                rupiah(transaction.amount),
                style: const TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.w800,
                ),
              ),

              const SizedBox(height: 12),

              const Text(
                'Transaksi yang dihapus tidak dapat dikembalikan.',
                style: TextStyle(color: _red, fontSize: 12),
              ),
            ],
          ),

          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext, false);
              },

              child: const Text('Batal'),
            ),

            FilledButton(
              style: FilledButton.styleFrom(
                backgroundColor: _red,
                foregroundColor: Colors.white,
              ),

              onPressed: () {
                Navigator.pop(dialogContext, true);
              },

              child: const Text('Hapus'),
            ),
          ],
        );
      },
    );

    if (!mounted || confirmed != true) {
      return;
    }

    try {
      final success = await ref
          .read(transactionStateProvider.notifier)
          .deleteTransaction(transactionId);

      if (!mounted) return;

      _showMessage(
        success ? 'Transaksi berhasil dihapus.' : 'Transaksi tidak ditemukan.',
      );
    } catch (error) {
      if (!mounted) return;

      _showMessage('Gagal menghapus transaksi: $error');
    }
  }

  // =====================================================
  // TRANSACTION ICON
  // =====================================================

  IconData _transactionIcon(FinanceTransaction transaction) {
    if (transaction.type == TransactionType.income) {
      return Icons.south_west_rounded;
    }

    final description = transaction.description.toLowerCase();

    if (RegExp(r'makan|nasi|kopi|sarapan|resto|food|lunch|dinner')
        .hasMatch(description)) {
      return Icons.restaurant_rounded;
    }

    if (RegExp(r'krl|kereta|transport|ojek|gojek|grab|bus|bensin|parkir|tj')
        .hasMatch(description)) {
      return Icons.directions_transit_rounded;
    }

    if (RegExp(r'belanja|beli|shop|market|grocery').hasMatch(description)) {
      return Icons.shopping_bag_rounded;
    }

    if (RegExp(r'listrik|tagihan|pulsa|internet|wifi').hasMatch(description)) {
      return Icons.receipt_long_rounded;
    }

    if (RegExp(r'tabung|simpan|saving').hasMatch(description)) {
      return Icons.savings_rounded;
    }

    return Icons.north_east_rounded;
  }

  // =====================================================
  // GROUP HISTORY BY DATE
  // =====================================================

  List<_HistoryEntry> _buildHistory(List<FinanceTransaction> transactions) {
    final result = <_HistoryEntry>[];

    String? lastDate;

    for (final transaction in transactions) {
      if (lastDate != transaction.dateString) {
        result.add(_HistoryEntry.date(transaction.date));

        lastDate = transaction.dateString;
      }

      result.add(_HistoryEntry.transaction(transaction));
    }

    return result;
  }

  // =====================================================
  // MONTH SELECTOR
  // =====================================================

  Widget _buildMonthSelector(TransactionViewState state) {
    final theme = Theme.of(context);

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 6),

      decoration: BoxDecoration(
        color: theme.cardColor,

        borderRadius: BorderRadius.circular(20),

        border: Border.all(
          color: theme.colorScheme.outlineVariant.withValues(alpha: 0.5),
        ),
      ),

      child: Row(
        children: [
          IconButton(
            tooltip: 'Bulan sebelumnya',

            icon: const Icon(Icons.chevron_left_rounded, size: 28),

            onPressed: () {
              _changeMonth(-1);
            },
          ),

          Expanded(
            child: Column(
              children: [
                Text(
                  'PERIODE',
                  style: TextStyle(
                    fontSize: 10,
                    letterSpacing: 1.2,
                    fontWeight: FontWeight.w600,
                    color: theme.colorScheme.onSurfaceVariant,
                  ),
                ),

                const SizedBox(height: 4),

                Text(
                  _formatMonth(state.selectedMonth),
                  textAlign: TextAlign.center,

                  style: const TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ],
            ),
          ),

          IconButton(
            tooltip: 'Bulan berikutnya',

            icon: const Icon(Icons.chevron_right_rounded, size: 28),

            onPressed: () {
              _changeMonth(1);
            },
          ),
        ],
      ),
    );
  }

  // =====================================================
  // DATE HEADER
  // =====================================================

  Widget _buildDateHeader(DateTime date) {
    final color = Theme.of(context).colorScheme.onSurfaceVariant;

    return Padding(
      padding: const EdgeInsets.only(top: 22, bottom: 10),

      child: Row(
        children: [
          Icon(Icons.calendar_today_rounded, size: 15, color: color),

          const SizedBox(width: 8),

          Expanded(
            child: Text(
              _formatDate(date),

              style: TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w600,
                color: color,
              ),
            ),
          ),
        ],
      ),
    );
  }

  // =====================================================
  // TRANSACTION CARD
  // =====================================================

  Widget _buildTransactionCard(FinanceTransaction transaction) {
    final theme = Theme.of(context);

    final isIncome = transaction.type == TransactionType.income;

    final color = isIncome ? _green : _red;

    final amountText = isIncome
        ? '+${rupiah(transaction.amount)}'
        : '-${rupiah(transaction.amount)}';

    final accountText = transaction.accountType == AccountType.cash
        ? transaction.accountName
        : '${transaction.accountType.label} • '
              '${transaction.accountName}';

    return Padding(
      padding: const EdgeInsets.only(bottom: 10),

      child: Material(
        color: theme.cardColor,

        borderRadius: BorderRadius.circular(20),

        child: InkWell(
          borderRadius: BorderRadius.circular(20),

          onTap: () {
            _openTransactionForm(transaction: transaction);
          },

          child: Padding(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 13),

            child: Row(
              children: [
                // ICON
                Container(
                  width: 46,
                  height: 46,

                  decoration: BoxDecoration(
                    color: color.withValues(alpha: 0.12),
                    borderRadius: BorderRadius.circular(15),
                  ),

                  child: Icon(_transactionIcon(transaction), color: color),
                ),

                const SizedBox(width: 12),

                // DESCRIPTION
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,

                    children: [
                      Text(
                        transaction.description,
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,

                        style: const TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w700,
                        ),
                      ),

                      const SizedBox(height: 5),

                      Text(
                        accountText,
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,

                        style: TextStyle(
                          fontSize: 11,
                          color: theme.colorScheme.onSurfaceVariant,
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(width: 8),

                // AMOUNT
                Flexible(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.end,

                    children: [
                      FittedBox(
                        fit: BoxFit.scaleDown,
                        alignment: Alignment.centerRight,

                        child: Text(
                          amountText,

                          style: TextStyle(
                            fontSize: 13,
                            fontWeight: FontWeight.w800,
                            color: color,
                          ),
                        ),
                      ),

                      const SizedBox(height: 5),

                      Text(
                        isIncome ? 'Masuk' : 'Keluar',

                        style: TextStyle(
                          fontSize: 10,
                          color: theme.colorScheme.onSurfaceVariant,
                        ),
                      ),
                    ],
                  ),
                ),

                // ACTION MENU
                PopupMenuButton<_TransactionAction>(
                  tooltip: 'Opsi transaksi',

                  icon: const Icon(Icons.more_vert_rounded, size: 20),

                  onSelected: (action) {
                    if (action == _TransactionAction.edit) {
                      _openTransactionForm(transaction: transaction);
                    } else if (action == _TransactionAction.delete) {
                      _confirmDelete(transaction);
                    }
                  },

                  itemBuilder: (_) {
                    return const [
                      PopupMenuItem(
                        value: _TransactionAction.edit,

                        child: Row(
                          children: [
                            Icon(Icons.edit_outlined),

                            SizedBox(width: 10),

                            Text('Edit'),
                          ],
                        ),
                      ),

                      PopupMenuItem(
                        value: _TransactionAction.delete,

                        child: Row(
                          children: [
                            Icon(Icons.delete_outline_rounded, color: _red),

                            SizedBox(width: 10),

                            Text('Hapus', style: TextStyle(color: _red)),
                          ],
                        ),
                      ),
                    ];
                  },
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  // =====================================================
  // PAGINATION FOOTER
  // =====================================================

  Widget _buildPaginationFooter(TransactionViewState state) {
    if (state.isLoadingMore) {
      return const Padding(
        padding: EdgeInsets.symmetric(vertical: 24),

        child: Center(child: CircularProgressIndicator()),
      );
    }

    if (state.hasMore) {
      return Padding(
        padding: const EdgeInsets.symmetric(vertical: 16),

        child: Center(
          child: OutlinedButton.icon(
            onPressed: () {
              ref.read(transactionStateProvider.notifier).loadMore();
            },

            icon: const Icon(Icons.expand_more_rounded),

            label: const Text('Muat Transaksi Lainnya'),
          ),
        ),
      );
    }

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 24),

      child: Center(
        child: Text(
          'Semua transaksi bulan ini sudah ditampilkan.',

          style: TextStyle(
            fontSize: 12,
            color: Theme.of(context).colorScheme.onSurfaceVariant,
          ),
        ),
      ),
    );
  }

  // =====================================================
  // EMPTY STATE
  // =====================================================

  Widget _buildEmptyState() {
    final scheme = Theme.of(context).colorScheme;

    return Center(
      child: Padding(
        padding: const EdgeInsets.fromLTRB(24, 30, 24, 110),

        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,

          children: [
            Container(
              width: 88,
              height: 88,

              decoration: BoxDecoration(
                color: scheme.primaryContainer,
                shape: BoxShape.circle,
              ),

              child: Icon(
                Icons.receipt_long_outlined,
                size: 42,
                color: scheme.onPrimaryContainer,
              ),
            ),

            const SizedBox(height: 19),

            const Text(
              'Belum Ada Transaksi',

              textAlign: TextAlign.center,

              style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800),
            ),

            const SizedBox(height: 9),

            Text(
              'Mulai catat pemasukan dan pengeluaranmu.',

              textAlign: TextAlign.center,

              style: TextStyle(fontSize: 13, color: scheme.onSurfaceVariant),
            ),

            const SizedBox(height: 22),

            FilledButton.icon(
              onPressed: () {
                _openTransactionForm();
              },

              style: FilledButton.styleFrom(
                backgroundColor: _green,
                foregroundColor: Colors.white,
              ),

              icon: const Icon(Icons.add_rounded),

              label: const Text('Tambah Transaksi'),
            ),
          ],
        ),
      ),
    );
  }

  // =====================================================
  // ERROR BANNER
  // =====================================================

  Widget _buildErrorBanner(String error) {
    return Container(
      padding: const EdgeInsets.all(14),

      decoration: BoxDecoration(
        color: _red.withValues(alpha: 0.10),

        borderRadius: BorderRadius.circular(15),

        border: Border.all(color: _red.withValues(alpha: 0.25)),
      ),

      child: Row(
        children: [
          const Icon(Icons.error_outline_rounded, color: _red),

          const SizedBox(width: 10),

          Expanded(child: Text(error, style: const TextStyle(fontSize: 12))),

          IconButton(
            tooltip: 'Coba lagi',

            icon: const Icon(Icons.refresh_rounded),

            onPressed: () {
              ref.read(transactionStateProvider.notifier).refresh();
            },
          ),
        ],
      ),
    );
  }

  // =====================================================
  // BUILD
  // =====================================================

  @override
  Widget build(BuildContext context) {
    final state = ref.watch(transactionStateProvider);

    final theme = Theme.of(context);

    // Filter transaksi berdasarkan bulan aktif.
    final transactions = state.transactions.where((transaction) {
      return transaction.date.year == state.selectedMonth.year &&
          transaction.date.month == state.selectedMonth.month;
    }).toList();

    // Kelompokkan transaksi berdasarkan tanggal.
    final historyEntries = _buildHistory(transactions);

    final hasTransactions = transactions.isNotEmpty;

    return Scaffold(
      backgroundColor: theme.scaffoldBackgroundColor,

      body: RefreshIndicator(
        color: _green,

        onRefresh: () {
          return ref.read(transactionStateProvider.notifier).refresh();
        },

        child: CustomScrollView(
          controller: _scrollController,

          physics: const AlwaysScrollableScrollPhysics(),

          slivers: [
            // =================================================
            // HEADER
            // =================================================

            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(16, 12, 16, 8),

                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,

                  children: [
                    Row(
                      children: [
                        Expanded(
                          child: Text(
                            'Transaksi',

                            style: theme.textTheme.headlineSmall?.copyWith(
                              fontWeight: FontWeight.w900,
                            ),
                          ),
                        ),

                        IconButton.filledTonal(
                          tooltip: 'Perbarui transaksi',

                          onPressed: state.isLoading
                              ? null
                              : () {
                                  ref
                                      .read(transactionStateProvider.notifier)
                                      .refresh();
                                },

                          icon: const Icon(Icons.refresh_rounded),
                        ),
                      ],
                    ),

                    const SizedBox(height: 16),

                    // MONTH SELECTOR
                    _buildMonthSelector(state),

                    const SizedBox(height: 14),

                    // TRANSACTION SUMMARY
                    TransactionSummaryCard(
                      totalIncome: state.totalIncome,
                      totalExpense: state.totalExpense,
                      transactionCount: state.transactionCount,
                    ),

                    const SizedBox(height: 25),

                    // HISTORY HEADER
                    Row(
                      children: [
                        const Expanded(
                          child: Text(
                            'Riwayat Transaksi',

                            style: TextStyle(
                              fontSize: 19,
                              fontWeight: FontWeight.w800,
                            ),
                          ),
                        ),

                        Text(
                          _formatMonth(state.selectedMonth),

                          style: TextStyle(
                            fontSize: 12,
                            color: theme.colorScheme.onSurfaceVariant,
                          ),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ),

            // =================================================
            // ERROR
            // =================================================
            if (state.error != null)
              SliverToBoxAdapter(
                child: Padding(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 16,
                    vertical: 8,
                  ),

                  child: _buildErrorBanner(state.error!),
                ),
              ),

            // =================================================
            // LOADING
            // =================================================
            if (state.isLoading && !hasTransactions)
              const SliverFillRemaining(
                hasScrollBody: false,

                child: Center(child: CircularProgressIndicator()),
              )
            // =================================================
            // EMPTY STATE
            // =================================================
            else if (!hasTransactions)
              SliverFillRemaining(
                hasScrollBody: false,

                child: _buildEmptyState(),
              )
            // =================================================
            // TRANSACTION HISTORY
            // =================================================
            else
              SliverPadding(
                padding: const EdgeInsets.fromLTRB(16, 0, 16, 110),

                sliver: SliverList(
                  delegate: SliverChildBuilderDelegate((context, index) {
                    if (index == historyEntries.length) {
                      return _buildPaginationFooter(state);
                    }

                    final entry = historyEntries[index];

                    if (entry.date != null) {
                      return _buildDateHeader(entry.date!);
                    }

                    return _buildTransactionCard(entry.transaction!);
                  }, childCount: historyEntries.length + 1),
                ),
              ),
          ],
        ),
      ),

      // =====================================================
      // ADD TRANSACTION BUTTON
      // =====================================================
      floatingActionButton: FloatingActionButton.extended(
        onPressed: state.isSaving
            ? null
            : () {
                _openTransactionForm();
              },

        backgroundColor: _green,
        foregroundColor: Colors.white,

        icon: const Icon(Icons.add_rounded),

        label: const Text(
          'Tambah',

          style: TextStyle(fontWeight: FontWeight.w700),
        ),
      ),
    );
  }
}
